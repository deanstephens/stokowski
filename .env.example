# Copy to .env and fill in. Stokowski auto-loads .env from the working dir.
# .env is gitignored — never commit real secrets.

# --- Linear (required) -------------------------------------------------------
# Personal API key from Linear → Settings → API → Personal API keys.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# --- Dashboard / remote terminal auth ---------------------------------------
# Bearer token for the dashboard and terminal routes. Generate one with:
#   openssl rand -hex 24
# Required if you bind a non-loopback host (server.host: 0.0.0.0).
STOKOWSKI_AUTH_TOKEN=

# --- Slack (optional; needed only if slack.enabled: true) -------------------
# Bot User OAuth Token (scope: chat:write) from your Slack app.
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# Signing Secret from the app's Basic Information page.
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Target channel ID (e.g. C0123ABCD). Invite the bot to this channel.
SLACK_CHANNEL_ID=C0123ABCD
